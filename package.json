    "configuration": {
      "type": "object",
      "title": "Go",
      "properties": {
        "go.goplsPath": {
          "type": "string",
          "default": "gopls",
          "description": "Path or executable name of gopls."
        },
        "go.goplsArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to gopls."
        },
        "go.goplsEnv": {
          "type": "object",
          "default": {},
          "description": "Environment variables added to the gopls process."
        },
        "go.goplsOptions": {
          "type": "object",
          "default": {},
          "description": "Initialization options passed to gopls."
        },
        "go.testFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to go test."
        },
        "go.testEnv": {
          "type": "object",
          "default": {},
          "description": "Environment variables added to go test processes."
        },
        "go.buildFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to go build."
        },
        "go.goPath": {
          "type": "string",
          "default": "go",
          "description": "Path or executable name of the Go command."
        },
        "go.goEnv": {
          "type": "object",
          "default": {},
          "description": "Environment variables added to Go and gopls processes."
        },
        "go.gopath": {
          "type": "string",
          "default": "",
          "description": "GOPATH used by Go tools."
        },
        "go.gobin": {
          "type": "string",
          "default": "",
          "description": "GOBIN directory used when locating installed Go tools."
        },
        "go.goroot": {
          "type": "string",
          "default": "",
          "description": "GOROOT used by Go tools."
        },
        "go.toolsEnvVars": {
          "type": "object",
          "default": {},
          "description": "Environment variables shared by Go tools."
        },
        "go.goplsUseDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Use the gopls remote daemon when supported."
        },
        "go.autoInstallGopls": {
          "type": "boolean",
          "default": true,
          "description": "Ask to install gopls when it is not found."
        },
        "go.autoInstallTools": {
          "type": "boolean",
          "default": false,
          "description": "Offer to install Go tools when a command needs a missing tool."
        },
        "go.buildOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run go build for the current package after saving a Go file."
        },
        "go.benchmarkFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to go test benchmarks."
        },
        "go.disable": {
          "type": "object",
          "default": {},
          "description": "Disable selected gopls language-client features."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "coc.nvim": "^0.0.83-next.27",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
