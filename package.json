        "title": "Test Go Function at Cursor or Repeat Previous",
        "category": "Go"
      },
      {
        "command": "go.subtest.cursor",
        "title": "Test Go Subtest at Cursor",
        "category": "Go"
      },
      {
        "command": "go.benchmark.package",
