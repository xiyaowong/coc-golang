        "category": "Go"
      },
      {
        "command": "go.locate.tools",
        "title": "Locate Go Tools",
        "category": "Go"
      },
      {
        "command": "go.languageserver.restart",
        "title": "Restart gopls",
        "category": "Go"
      },
      {
        "command": "go.build.workspace",
        "title": "Build Go Workspace",
        "category": "Go"
      },
      {
        "command": "go.vet.workspace",
        "title": "Vet Go Workspace",
        "category": "Go"
