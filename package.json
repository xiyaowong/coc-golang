{
  "name": "coc-golang",
  "version": "0.1.0",
  "description": "Go language support for coc.nvim using gopls",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiyaowong/coc-golang"
  },
  "keywords": [
    "coc.nvim",
    "golang",
    "gopls"
  ],
  "engines": {
    "coc": "^0.0.83-next.27",
    "node": ">=22.18.0"
  },
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:gomod",
    "onLanguage:gowork",
    "onCommand:go.test.package",
    "onCommand:go.test.explorer",
    "onCommand:go.test.workspace",
    "onCommand:go.test.file",
    "onCommand:go.test.cursor",
    "onCommand:go.test.cursorOrPrevious",
    "onCommand:go.subtest.cursor",
    "onCommand:go.benchmark.package",
    "onCommand:go.benchmark.cursor",
    "onCommand:go.benchmark.file",
    "onCommand:go.test.coverage",
    "onCommand:go.test.previous",
    "onCommand:go.build.package",
    "onCommand:go.vet.package",
    "onCommand:go.run",
    "onCommand:go.gopath",
    "onCommand:go.goroot",
    "onCommand:go.environment.choose",
    "onCommand:go.tools.install",
    "onCommand:go.languageserver.restart",
    "onCommand:go.build.workspace",
    "onCommand:go.vet.workspace",
    "onCommand:go.lint.package",
    "onCommand:go.lint.workspace",
    "onCommand:go.fmt.package",
    "onCommand:go.import.organize",
    "onCommand:go.generate.package",
    "onCommand:go.mod.tidy",
    "onCommand:go.mod.vendor",
    "onCommand:go.work.sync",
    "onCommand:go.mod.init",
    "onCommand:go.get.package",
    "onCommand:go.install.package",
    "onCommand:go.test.generate.file",
    "onCommand:go.test.generate.package",
    "onCommand:go.test.generate.function",
    "onCommand:go.tags.add",
    "onCommand:go.tags.remove",
    "onCommand:go.tags.clear",
    "onCommand:go.impl.cursor",
    "onCommand:go.test.cancel",
    "onCommand:go.test.showOutput",
    "onCommand:go.browse.packages",
    "onCommand:go.gopls.install",
    "onCommand:go.tools.install.dlv",
    "onCommand:go.tools.install.goimports",
    "onCommand:go.tools.install.staticcheck",
    "onCommand:go.tools.install.gomodifytags",
    "onCommand:go.tools.install.gotests",
    "onCommand:go.tools.install.impl",
    "onCommand:go.tools.install.gopls",
    "onCommand:go.version",
    "onCommand:go.env",
    "onCommand:go.locate.tools"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepare": "tsdown",
    "test": "npm run build && node --test"
  },
  "contributes": {
    "commands": [
      {
        "command": "go.test.package",
        "title": "Test Go Package",
        "category": "Go"
      },
